{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tripto-api",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-20",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tripto-db",
      "database_id": "6064a780-9b39-4bb7-9af7-c972a33ac7e1"
    }
  ],
  "vars": {
    "LIVE_FLIGHTS_ENABLED": "false",
    "AI_ENABLED": "false",
    "GMAIL_SYNC_ENABLED": "false",
    "R2_DOCUMENTS_ENABLED": "false",
    "ACCOUNT_AUTH_ENABLED": "true",
    "GOOGLE_CLIENT_ID": "832895442630-6enisft24gupqct0igg1uldv9hnqsjsh.apps.googleusercontent.com",
    "APP_BASE_URL": "https://tripto.to",
    "SHARING_ENABLED": "false",
    "DEMO_TOOLS_ENABLED": "false",
    "BETA_RELEASE": "product-v2-production",
    "BETA_METRICS_ENABLED": "true",
    "OPS_ENABLED": "false"
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  }
}
