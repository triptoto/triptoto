/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin-allow-popups

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# Content-versioned via the ?v= token stamped into index.html on every deploy.
# The path is reused but each ?v= is a distinct, immutable URL, so the browser
# HTTP cache can hold these forever; a new deploy carries a new ?v= (a fresh URL
# => cache miss => fresh bytes). This removes the per-launch revalidation that
# made warm starts wait on the network.
/mobile-app.min.js
  Cache-Control: public, max-age=31536000, immutable

/mobile-app.min.css
  Cache-Control: public, max-age=31536000, immutable

/i18n.js
  Cache-Control: public, max-age=31536000, immutable

/locales/*
  Cache-Control: public, max-age=31536000, immutable
